{
  "name": "kaption-whatsapp-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes WhatsApp (via WhatsApp Web) so an LLM can read chats, search messages and send messages.",
  "type": "module",
  "bin": {
    "kaption-whatsapp-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.5.0"
  }
}
